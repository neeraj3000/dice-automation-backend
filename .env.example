# ==============================================================================
# Apply2Hire (A2H) Backend Configuration Template
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Application Environment ('development' or 'production')
# In production, strict secret and CORS validations are enforced on startup.
ENVIRONMENT=development

# Explicit allowed CORS origins (comma-separated list, e.g. https://app.apply2hire.com)
# REQUIRED in production. Wildcards ('*') are strictly rejected in production when credentials are true.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Approved Chrome Extension ID (required if connecting from the Apply2Hire Chrome Extension)
CHROME_EXTENSION_ID=

# MongoDB Database Connection
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=apply2hire

# JWT Authentication
# In production, JWT_SECRET must be configured with a random high-entropy key (min 32 characters).
# Default placeholder values are rejected by startup validation in production.
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-or-base64-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session Encryption Key
# Used for application-level encryption of candidate Dice session cookies and credentials.
# REQUIRED in production. Must be a 32-byte URL-safe base64-encoded string (or high-entropy secret).
# Example to generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key-or-32-byte-base64-key

# Browser Infrastructure Configuration ('local' for desktop execution, 'server' for cloud/container)
BROWSER_MODE=local
HEADLESS=true

# Google OAuth Credentials (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Cloud Storage (required for remote resume storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# OpenAI API Key (required for LLM-based resume parsing and matching)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
