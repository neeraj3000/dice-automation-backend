# ==========================================
# Dice Job Application Automation MVP Config
# ==========================================

# 1. MongoDB Connection
# Default is your local MongoDB instance running on port 27017 or MongoDB Atlas URI in production
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=dice_automation

# 2. OpenAI API Key (Optional)
# If provided, enables GPT-4o-mini for structured JD parsing and deep semantic resume matching.
# If left blank, the system automatically uses the fast built-in heuristic & algorithmic matcher.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Browser Infrastructure Configuration
# BROWSER_MODE: 'local' (headed/desktop) or 'server' (cloud/headless)
BROWSER_MODE=local
# HEADLESS: 'false' for local headed view, 'true' for server/cloud headless
HEADLESS=false
# BROWSER_DATA_DIR: Storage path for isolated user/session browser profiles
BROWSER_DATA_DIR=./data/browser_profiles

# 4. Session Storage & Security
# SESSION_ENCRYPTION_KEY: Passphrase or 32-byte key used to encrypt sensitive session tokens/cookies in persistent storage
SESSION_ENCRYPTION_KEY=

# 5. File Upload Limits
MAX_FILE_SIZE_MB=20

# 6. Cross-Origin Resource Sharing (CORS)
# Allowed frontend origins (comma-separated, e.g. http://localhost:5173,https://my-frontend.onrender.com or * for all)
CORS_ORIGINS=*
